        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Usuario {\n        -int idUsuario\n        -string nombre\n        -string correo\n        -string contrasena\n        +iniciar_sesion() bool\n        +consultar_reportes()\n        +registrar_incidente()\n    }\n\n    class MiembroComunidad {\n        -string sectorResidencia\n        +enviar_reporte()\n    }\n\n    class EstudianteVoluntario {\n        -string centroEducativo\n        -string carnetEstudiantil\n        +registrar_inspeccion()\n        +verificar_evidencia()\n    }\n\n    class Administrador {\n        -string nivelAcceso\n        +cambiar_estado_reporte()\n        +gestionar_usuarios()\n    }\n\n    class ReporteAgua {\n        -int idReporte\n        -DateTime fechaRegistro\n        -string descripcion\n        -string prioridad\n        -string estado\n        +crear_reporte() bool\n        +asignar_prioridad()\n        +actualizar_estado()\n        +mostrar_detalle()\n    }\n\n    class Ubicacion {\n        -int idUbicacion\n        -string direccionExacta\n        -string municipio\n        -double latitud\n        -double longitud\n        +registrar_coordenadas()\n        +obtener_direccion()\n    }\n\n    class TipoIncidente {\n        -int idTipoIncidente\n        -string nombreTipo\n        -string descripcion\n        +obtener_categoria()\n    }\n\n    class Evidencia {\n        -int idEvidencia\n        -string urlArchivo\n        -DateTime fechaSubida\n        +adjuntar_foto()\n        +visualizar_evidencia()\n    }\n\n    class Seguimiento {\n        -int idSeguimiento\n        -string estadoAnterior\n        -string nuevoEstado\n        -DateTime fechaActualizacion\n        -string comentario\n        +registrar_avance()\n        +consultar_historial()\n    }\n\n    Usuario &lt;|-- MiembroComunidad\n    Usuario &lt;|-- EstudianteVoluntario\n    Usuario &lt;|-- Administrador\n\n    Usuario \&quot;1\&quot; --&gt; \&quot;1..*\&quot; ReporteAgua : crea\n    ReporteAgua \&quot;1\&quot; --&gt; \&quot;1\&quot; Ubicacion : tiene\n    ReporteAgua \&quot;*\&quot; --&gt; \&quot;1\&quot; TipoIncidente : clasifica\n    ReporteAgua \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Evidencia : adjunta\n    ReporteAgua \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Seguimiento : actualiza\n    Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Seguimiento : registra&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="qT1hrjnXq0Mwl_whVzMY-154">
